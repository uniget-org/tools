#syntax=docker/dockerfile

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version

RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
url="https://github.com/superradcompany/microsandbox/releases/download/v${version}/microsandbox-linux-${arch}.tar.gz"
filename="$( basename "${url}" )"

check-github-release-asset "superradcompany/microsandbox" "v${version}" "${filename}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

tar --file="${uniget_cache_download}/${filename}" --list
mkdir -p /tmp/microsandbox
tar --file="${uniget_cache_download}/${filename}" --extract --gzip --directory="/tmp/microsandbox/" --no-same-owner
install --mode=0755 /tmp/microsandbox/msb "${prefix}/bin/msb"
install --mode=0644 /tmp/microsandbox/libkrunfw.so.* "${prefix}/lib/"
ln --relative --symbolic --force "${prefix}/bin/msb" "${prefix}/bin/microsandbox"
rm -rf /tmp/microsandbox
EOF
RUN <<EOF
"${prefix}/bin/msb" completion bash >"${prefix}/share/bash-completion/completions/msb"
"${prefix}/bin/msb" completion fish >"${prefix}/share/fish/vendor_completions.d/msb.fish"
"${prefix}/bin/msb" completion zsh >"${prefix}/share/zsh/vendor-completions/_msb"
EOF