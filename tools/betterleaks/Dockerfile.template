#syntax=docker/dockerfile:1.27.0@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04@sha256:0e9f873df6c03f698322571475f367a694d7eff9077e5019ae764e5106a6da16 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version

RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
echo "### Setting architecture string for ${TARGETPLATFORM}"
case "${arch}" in
    x86_64)
        export arch_suffix="x64"
        ;;
    aarch64)
        export arch_suffix="arm64"
        ;;
    *)
        echo "ERROR: Unsupported architecture ${arch}."
        exit 1
        ;;
esac
echo "    Using ${arch_suffix}"

url="https://github.com/betterleaks/betterleaks/releases/download/v${version}/betterleaks_${version}_linux_${arch_suffix}.tar.gz"
filename="$( basename "${url}" )"

check-download "${url}"
check-github-release-asset "betterleaks/betterleaks" "v${version}" "${filename}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

tar --file="${uniget_cache_download}/${filename}" --list
tar --file="${uniget_cache_download}/${filename}" --extract --gzip --directory="${prefix}/bin/" --no-same-owner \
    betterleaks

"${prefix}/bin/betterleaks" completion bash >"${prefix}/share/bash-completion/completions/betterleaks"
"${prefix}/bin/betterleaks" completion fish >"${prefix}/share/fish/vendor_completions.d/betterleaks.fish"
"${prefix}/bin/betterleaks" completion zsh >"${prefix}/share/zsh/vendor-completions/_betterleaks"
EOF
