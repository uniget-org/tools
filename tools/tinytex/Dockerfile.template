#syntax=docker/dockerfile

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN <<EOF
echo "### Setting architecture string for ${TARGETPLATFORM}"
case "${arch}" in
    x86_64)
        export arch_suffix="linux-${arch}"
        ;;
    aarch64)
        export arch_suffix="linux-${alt_arch}"
        ;;
    *)
        echo "ERROR: Unsupported architecture ${arch}."
        exit 1
        ;;
esac
echo "    Using ${arch_suffix}"

url="https://github.com/rstudio/tinytex-releases/releases/download/v${version}/TinyTeX-${arch_suffix}-v${version}.tar.xz"
filename="$( basename "${url}" )"

check-github-release-asset "rstudio/tinytex-releases" "v${version}" "${filename}"
curl --silent --show-error --location --fail --output "/tmp/${filename}" \
    "${url}"

tar --file="/tmp/${filename}" --list
mkdir -p "${prefix}/opt/tinytex"
tar --file="/tmp/${filename}" --extract --xz --directory="${prefix}/opt/tinytex" --strip-components=1 --no-same-owner
EOF
