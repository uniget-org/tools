#syntax=docker/dockerfile

FROM rust:alpine AS build
RUN <<EOF
apk update
apk add \
    build-base \
    git \
    bash
EOF
WORKDIR /tmp/github.com/uutils/coreutils
ARG name
ARG version
RUN --mount=type=cache,target=/target \
    --mount=type=cache,target=/usr/local/cargo/registry <<EOF
git clone -q --config advice.detachedHead=false --depth 1 --branch "${version}" https://github.com/uutils/coreutils .
cargo install --bin uudoc --features uudoc --path .
EOF

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
url="https://github.com/uutils/coreutils/releases/download/${version}/coreutils-${version}-${arch}-unknown-linux-musl.tar.gz"
filename="$( basename "${url}" )"

check-download "${url}"
check-github-release-asset "uutils/coreutils" "${version}" "${filename}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

tar --file="${uniget_cache_download}/${filename}" --list
tar --file="${uniget_cache_download}/${filename}" --extract --gzip --directory="${prefix}/bin/" --strip-components=1 --no-same-owner \
    "coreutils-${version}-${arch}-unknown-linux-musl/coreutils"
EOF
COPY --from=build "/usr/local/cargo/bin/uudoc" "/usr/local/bin/"
RUN <<EOF
"${prefix}/bin/coreutils" --list | xargs -I{} ln --symbolic --relative --force "${prefix}/bin/coreutils" "${prefix}/bin/{}"

utilities="$(uudoc --help | sed '/Available utilities/,$!d' | grep -v 'Available utilities' | tr -d ' ' | tr -d '\n' | tr , '\n')"
echo "${utilities}" | xargs -I{} bash -c 'uudoc manpage {} >"${prefix}/share/man/man1/{}.1"'
echo "${utilities}" | xargs -I{} bash -c 'uudoc completion {} bash >"${prefix}/share/bash-completion/completions/{}"'
echo "${utilities}" | xargs -I{} bash -c 'uudoc completion {} fish >"${prefix}/share/fish/vendor_completions.d/{}.fish"'
echo "${utilities}" | xargs -I{} bash -c 'uudoc completion {} zsh >"${prefix}/share/zsh/vendor-completions/_{}"'
EOF
