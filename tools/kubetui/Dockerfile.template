#syntax=docker/dockerfile:1.26.0@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04@sha256:0e9f873df6c03f698322571475f367a694d7eff9077e5019ae764e5106a6da16 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
url="https://github.com/sarub0b0/kubetui/releases/download/v${version}/kubetui-${arch}-unknown-linux-musl"
filename="$(basename "${url}")"

check-github-release-asset "sarub0b0/kubetui" "v${version}" "${filename}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

install --mode=0755 \
    "${uniget_cache_download}/${filename}" \
    "${prefix}/bin/kubetui"
EOF
RUN <<EOF
"${prefix}/bin/kubetui" completion bash >"${prefix}/share/bash-completion/completions/kubetui"
"${prefix}/bin/kubetui" completion zsh >"${prefix}/share/zsh/vendor-completions/_kubetui"
EOF