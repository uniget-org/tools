#syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version

RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
echo "### Setting architecture string for ${TARGETPLATFORM}"
case "${alt_arch}" in
    amd64)
        export arch_suffix="x86_64"
        ;;
    arm64)
        export arch_suffix="aarch64"
        ;;
    *)
        echo "ERROR: Unsupported architecture ${alt_arch}."
        exit 1
        ;;
esac
echo "    Using ${arch_suffix}"

url="https://github.com/vercel-labs/fx/releases/download/v${version}/fx-linux-${arch_suffix}.tar.gz"
filename="$( basename "${url}" )"

check-github-release-asset "vercel-labs/fx" "v${version}" "${filename}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

tar --file="${uniget_cache_download}/${filename}" --extract --gzip --directory=/tmp --no-same-owner
install --mode=0755 \
    /tmp/fx \
    "${prefix}/bin/fx"
EOF
