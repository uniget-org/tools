#syntax=docker/dockerfile

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
echo "### Setting architecture string for ${TARGETPLATFORM}"
case "${arch}" in
    x86_64)
        export arch_suffix="x64"
        ;;
    aarch64)
        export arch_suffix="arm64"
        ;;
    *)
        echo "ERROR: Unsupported architecture ${arch}."
        exit 1
        ;;
esac
echo "    Using ${arch_suffix}"

url="https://github.com/Tracer-Cloud/opensre/releases/download/v${version}/opensre_${version}_linux-${arch_suffix}.tar.gz"
filename="$( basename "${url}" )"

check-github-release-asset "Tracer-Cloud/opensre" "v${version}" "${filename}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

tar --file="${uniget_cache_download}/${filename}" --list | head -n 5
tar --file="${uniget_cache_download}/${filename}" --extract --gzip --directory="${prefix}/libexec" --no-same-owner
ln --symbolic --relative "${prefix}/libexec/opensre/opensre" "${prefix}/bin/opensre"
EOF
