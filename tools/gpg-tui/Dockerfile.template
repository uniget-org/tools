#syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e

FROM registry.gitlab.com/uniget-org/images/build-base:3.24 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN <<EOF
apk update
apk add --no-cache \
    rust \
    cargo \
    musl-dev \
    libgpg-error-dev \
    libgpgme-dev
EOF
COPY --link --from=rust / /usr/local/
WORKDIR /tmp/github.com/orhun/gpg-tui
RUN <<EOF
git clone -q --config advice.detachedHead=false --depth 1 --branch "v${version}" https://github.com/orhun/gpg-tui .
cargo build --release --bin gpg-tui --target "${arch}-unknown-linux-musl"
cp "target/${arch}-unknown-linux-musl/release/gpg-tui" "${prefix}/bin/"
EOF