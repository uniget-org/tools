#syntax=docker/dockerfile:1.26.0@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04@sha256:059b11407572b2fd733e7bcd1c528852394d7fe1abef7119a1a97356983cab76 AS ubuntu2604

FROM ubuntu2604 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
url="https://dl.enum.co/enumctl/${version}/enumctl-linux-${alt_arch}"
filename="$( basename "${url}" )"

check-download "${url}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

install --mode=0755 \
    "${uniget_cache_download}/${filename}" \
    "${prefix}/bin/enumctl"
EOF
RUN <<EOF
"${prefix}/bin/enumctl" completion bash >"${prefix}/share/bash-completion/completions/enumctl"
"${prefix}/bin/enumctl" completion fish >"${prefix}/share/fish/vendor_completions.d/enumctl.fish"
"${prefix}/bin/enumctl" completion zsh >"${prefix}/share/zsh/vendor-completions/_enumctl"
EOF