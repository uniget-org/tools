#syntax=docker/dockerfile

FROM ghcr.io/uniget-org/tools/make:latest AS make

FROM registry.gitlab.com/uniget-org/images/build-essential:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
COPY --link --from=make / /usr/local/
WORKDIR /tmp/libmnl
ARG name
ARG version
RUN <<EOF
url="https://www.netfilter.org/pub/libmnl/libmnl-${version}.tar.bz2"

check-download "${url}"
curl --silent --show-error --location --fail --output "/tmp/libmnl-${version}.tar.bz2" \
    "${url}"

tar --file="/tmp/libmnl-${version}.tar.bz2" --list
tar --file="/tmp/libmnl-${version}.tar.bz2" --extract --bzip2 --strip-components=1 --no-same-owner

./configure \
    --prefix="${prefix}" \
    --enable-static=yes \
    --enable-shared=yes
make -j$(nproc)
make install
EOF