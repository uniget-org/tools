#syntax=docker/dockerfile

FROM ghcr.io/uniget-org/tools/node-lts:latest AS node
FROM ghcr.io/uniget-org/tools/npm:latest AS npm

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
COPY --link --from=node / /usr/local/
COPY --link --from=npm / /usr/local/
WORKDIR /uniget_bootstrap/libexec/pi
ARG name
ARG version
RUN <<EOF
npm install \
    --omit=dev \
    "@earendil-works/pi-coding-agent@${version}"
ln --symbolic --relative --force "${prefix}/libexec/pi/node_modules/.bin/pi" "${prefix}/bin/"
EOF