#syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
url="https://github.com/NeuralNotwerk/cgg/releases/download/v${version}/cgg-v${version}-linux-${arch}.tar.gz"
filename="$( basename "${url}" )"

check-github-release-asset "NeuralNotwerk/cgg" "v${version}" "${filename}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

tar --file="${uniget_cache_download}/${filename}" --list
tar --file="${uniget_cache_download}/${filename}" --extract --gzip --directory="${prefix}/bin/" --no-same-owner \
    ./cgg \
    ./cgg.h \
    ./libcgg.a \
    ./libcgg.so

mv "${prefix}/bin/libcgg.a" "${prefix}/bin/libcgg.so" "${prefix}/lib/"
mv "${prefix}/bin/cgg.h" "${prefix}/include/"
EOF
