#syntax=docker/dockerfile

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
base_url="https://github.com/WasmEdge/WasmEdge/releases/download/${version}"

for file in "WasmEdge-${version}-manylinux_2_28_${arch}.tar.gz" "WasmEdge-${version}-alpine3.23_${arch}_static.tar.gz"; do
    url="${base_url}/${file}"
    filename="$( basename "${url}" )"

    check-github-release-asset "WasmEdge/WasmEdge" "${version}" "${filename}"
    curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
        "${url}"

    tar --file="${uniget_cache_download}/${filename}" --list
    tar --file="${uniget_cache_download}/${filename}" --extract --gzip --directory="${prefix}" --no-same-owner
done
EOF