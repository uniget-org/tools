#syntax=docker/dockerfile

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
url="https://github.com/openinterpreter/openinterpreter/releases/download/rust-v${version}/open-interpreter-package-${arch}-unknown-linux-musl.tar.gz"
filename="$( basename "${url}" )"

check-github-release-asset "openinterpreter/openinterpreter" "rust-v${version}" "${filename}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

tar --file="${uniget_cache_download}/${filename}" --list | head -n 5
mkdir -p "${prefix}/libexec/openinterpreter"
tar --file="${uniget_cache_download}/${filename}" --extract --gzip \
    --directory="${prefix}/libexec/openinterpreter" --no-same-owner

ln --symbolic --relative "${prefix}/libexec/openinterpreter/bin/interpreter" "${prefix}/bin/interpreter"
ln --symbolic --relative "${prefix}/libexec/openinterpreter/bin/i" "${prefix}/bin/i"
EOF
RUN <<EOF
"${prefix}/bin/openinterpreter" completion bash >"${prefix}/share/bash-completion/completions/openinterpreter"
"${prefix}/bin/openinterpreter" completion fish >"${prefix}/share/fish/vendor_completions.d/openinterpreter.fish"
"${prefix}/bin/openinterpreter" completion zsh >"${prefix}/share/zsh/vendor-completions/_openinterpreter"
EOF