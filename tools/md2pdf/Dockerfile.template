#syntax=docker/dockerfile

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
url="https://github.com/solworktech/md2pdf/releases/download/v${version}/mdtopdf_${version}_${alt_arch}.deb"
filename="$( basename "${url}" )"

check-github-release-asset "solworktech/md2pdf" "v${version}" "${filename}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

dpkg --extract "${uniget_cache_download}/${filename}" "/tmp"
mv /tmp/usr/bin/md2pdf "${prefix}/bin/"
mv /tmp/usr/share/mdtopdf/ "${prefix}/share/"
EOF
