#syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e

FROM ghcr.io/uniget-org/tools/libgmp:latest AS libgmp
FROM ghcr.io/uniget-org/tools/libtpms:latest AS libtpms
FROM ghcr.io/uniget-org/tools/make:latest AS make
FROM ghcr.io/uniget-org/tools/python-3.12:latest AS python

FROM registry.gitlab.com/uniget-org/images/build-essential:26.04@sha256:0761326451efd5adfeaa56278c455d16cf8d5e4303b3fd3d99031af25b3da6c8 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN --mount=type=cache,target=/var/cache/apt <<EOF
apt-get update
apt-get -y install --no-install-recommends \
    libfuse-dev \
    libglib2.0-dev \
    libjson-glib-dev \
    net-tools \
    selinux-policy-dev \
    socat \
    trousers \
    libgnutls30 \
    libtasn1-6-dev \
    libssl-dev \
    expect \
    libseccomp-dev
EOF
COPY --link --from=libgmp / /usr/
COPY --link --from=libtpms / /usr/
COPY --link --from=python / /usr/local/
WORKDIR /tmp/swtmp
RUN <<EOF
git clone -q --config advice.detachedHead=false --depth 1 --branch "v${version}" https://github.com/stefanberger/swtpm .
EOF
RUN <<EOF
./autogen.sh --prefix="${prefix}" --without-selinux
make -j$(nproc)
make install
rm -rf "${prefix}/libexec/installed-tests/"
EOF