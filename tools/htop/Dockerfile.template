#syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e

FROM registry.gitlab.com/uniget-org/images/build-essential:26.04@sha256:5ee01cd64296e795943405f10d803592dbd27cad7d35cd6ee1271bf177a71146 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
WORKDIR /tmp/htop
ARG name
ARG version
RUN <<EOF
apt-get update
apt-get -y install --no-install-recommends \
    autoconf \
    automake \
    libcap-dev \
    libtool \
    pkg-config \
    libsensors-dev \
    libncursesw5-dev
EOF
RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
url="https://github.com/htop-dev/htop/releases/download/${version}/htop-${version}.tar.xz"
filename="$( basename "${url}" )"

check-github-release-asset "htop-dev/htop" "${version}" "${filename}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

tar --file="${uniget_cache_download}/${filename}" --extract --xz --strip-components=1 --no-same-owner
./configure \
    --prefix="${prefix}" \
    --enable-static \
    --enable-capabilities \
    --enable-sensors \
    --with-proc=/proc
make -j$(nproc)
make install
EOF
