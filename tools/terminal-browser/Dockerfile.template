#syntax=docker/dockerfile

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
echo "### Setting architecture string for ${TARGETPLATFORM}"
case "${arch}" in
    x86_64)
        export arch_suffix="x64"
        ;;
    aarch64)
        export arch_suffix="arm64"
        ;;
    *)
        echo "ERROR: Unsupported architecture ${arch}."
        exit 1
        ;;
esac
echo "    Using ${arch_suffix}"

url="https://github.com/zenbu-labs/terminal-browser/releases/download/v${version}/terminal-browser-linux-${arch_suffix}.tar.gz"
filename="$( basename "${url}" )"

check-github-release-asset "zenbu-labs/terminal-browser" "v${version}" "${filename}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

mkdir --parents "${prefix}/libexec/terminal-browser"
tar --file="${uniget_cache_download}/${filename}" --list | head
tar --file="${uniget_cache_download}/${filename}" --extract --gzip --directory="${prefix}/libexec/terminal-browser" --strip-components=1 --no-same-owner
ln --symbolic --relative --force "${prefix}/libexec/terminal-browser/bin/terminal-browser" "${prefix}/bin/terminal-browser"
EOF
