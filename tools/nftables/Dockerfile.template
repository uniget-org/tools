#syntax=docker/dockerfile

FROM ghcr.io/uniget-org/tools/make:latest AS make
FROM ghcr.io/uniget-org/tools/libmnl:latest AS libmnl
FROM ghcr.io/uniget-org/tools/libnftnl:latest AS libnftnl
FROM ghcr.io/uniget-org/tools/iptables:latest AS iptables
FROM ghcr.io/uniget-org/tools/libjansson:latest AS libjansson
FROM ghcr.io/uniget-org/tools/libgmp:latest AS libgmp

FROM registry.gitlab.com/uniget-org/images/build-essential:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
RUN --mount=type=cache,target=/var/cache/apt <<EOF
apt-get update
apt-get -y install --no-install-recommends \
    bison \
    flex \
    asciidoc \
    libeditreadline-dev
EOF
COPY --link --from=make / /usr/local/
COPY --link --from=libmnl / /usr/local/
COPY --link --from=libnftnl / /usr/local/
COPY --link --from=iptables / /usr/local/
COPY --link --from=libjansson / /usr/local/
COPY --link --from=libgmp / /usr/local/
WORKDIR /tmp/nftables
ARG name
ARG version
RUN <<EOF
url="https://www.netfilter.org/pub/nftables/nftables-${version}.tar.xz"

check-download "${url}"
curl --silent --show-error --location --fail --output "/tmp/nftables-${version}.tar.xz" \
    "${url}"

tar --file="/tmp/nftables-${version}.tar.xz" --list
tar --file="/tmp/nftables-${version}.tar.xz" --extract --xz --strip-components=1 --no-same-owner

./configure \
    --prefix="${prefix}" \
    --enable-shared \
    --enable-static \
    --with-xtables \
    --with-json \
    --without-cli
make -j$(nproc)
make install
EOF