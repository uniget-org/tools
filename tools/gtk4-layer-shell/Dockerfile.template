#syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04@sha256:0e9f873df6c03f698322571475f367a694d7eff9077e5019ae764e5106a6da16 AS ubuntu2404

FROM ubuntu2404 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN <<EOF
apt-get update
apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    meson \
    ninja-build \
    libwayland-dev \
    wayland-protocols \
    libgtk-4-dev \
    gobject-introspection \
    libgirepository1.0-dev \
    gtk-doc-tools \
    python3 \
    python3-gi \
    valac
EOF
WORKDIR /tmp/gtk4-layer-shell
RUN <<EOF
git clone -q --config advice.detachedHead=false --depth 1 --branch "v${version}" https://github.com/wmww/gtk4-layer-shell .
meson setup build \
    --prefix="${prefix}" \
    -Dtests=true \
    -Dintrospection=true \
    -Dvapi=true
ninja -C build
ninja -C build install
EOF