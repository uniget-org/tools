#syntax=docker/dockerfile

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
url="https://github.com/aurc/loggo/releases/download/v${version}/loggo_${version}_linux_${alt_arch}.tar.gz"
filename="$( basename "${url}" )"

check-github-release-asset "aurc/loggo" "v${version}" "${filename}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

tar --file="${uniget_cache_download}/${filename}" --list
mkdir --parents "${uniget_cache_download}/${filename}-out"
tar --file="${uniget_cache_download}/${filename}" --extract --gzip --directory="${uniget_cache_download}/${filename}-out" --no-same-owner
install --mode=0755 \
    "${uniget_cache_download}/${filename}-out/loggo" \
    "${prefix}/bin/loggo"
EOF
