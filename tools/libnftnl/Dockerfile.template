#syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e

FROM ghcr.io/uniget-org/tools/make:latest AS make
FROM ghcr.io/uniget-org/tools/libmnl:latest AS libmnl

FROM registry.gitlab.com/uniget-org/images/build-essential:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
COPY --link --from=make / /usr/local/
COPY --link --from=libmnl / /usr/local/
WORKDIR /tmp/libnftnl
ARG name
ARG version
RUN <<EOF
url="https://www.netfilter.org/pub/libnftnl/libnftnl-${version}.tar.xz"

check-download "${url}"
curl --silent --show-error --location --fail --output "/tmp/libnftnl-${version}.tar.xz" \
    "${url}"

tar --file="/tmp/libnftnl-${version}.tar.xz" --list
tar --file="/tmp/libnftnl-${version}.tar.xz" --extract --xz --strip-components=1 --no-same-owner

export PKG_CONFIG_PATH="/lib/pkgconfig:${PKG_CONFIG_PATH}"
./configure \
    --prefix="${prefix}" \
    --enable-static=yes \
    --enable-shared=yes
make -j$(nproc)
make install
EOF