#syntax=docker/dockerfile

FROM ghcr.io/uniget-org/tools/zig:latest AS zig

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
RUN <<EOF
apt-get update
apt-get install -y \
    libegl1 \
    libadwaita-1-0 \
    libgtk4-layer-shell0
EOF
ARG name
ARG version
RUN <<EOF
mkdir -p "${prefix}/lib/ghostty"
cp -r /usr/lib/$(uname -m)-linux-gnu/* "${prefix}/lib/ghostty/"
EOF
COPY com.mitchellh.ghostty.desktop.go-template /uniget_bootstrap/share/applications/
COPY app-com.mitchellh.ghostty.service.go-template /uniget_bootstrap/share/systemd/user/
COPY app-com.mitchellh.ghostty.service.go-template /uniget_bootstrap/share/dbus-1/services/