#syntax=docker/dockerfile

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS ubuntu2604

FROM ubuntu2604 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
url="https://github.com/pkgforge-dev/ghostty-appimage/releases/download/v${version}/Ghostty-${version}-${arch}.AppImage"
filename="$( basename "${url}" )"

check-github-release-asset "pkgforge-dev/ghostty-appimage" "v${version}" "${filename}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

install --mode=0755 \
    "${uniget_cache_download}/${filename}" \
    "${prefix}/bin/Ghostty.AppImage"
EOF
RUN <<EOF
mkdir -p "${prefix}/share/icons/hicolor/256x256/apps/"
curl --silent --show-error --location --fail https://github.com/ghostty-org/ghostty/archive/refs/tags/v${version}.tar.gz \
| tar --extract --gzip --directory=/tmp --no-same-owner \
    "ghostty-${version}/images/icons/"
mv "/tmp/ghostty-${version}/images/icons/icon_256.png" "${prefix}/share/icons/hicolor/256x256/apps/com.mitchellh.ghostty.png"
EOF
COPY ghostty-noble.desktop.go-template /uniget_bootstrap/share/applications/