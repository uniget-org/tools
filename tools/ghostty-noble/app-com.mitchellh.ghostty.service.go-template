[Unit]
Description=Ghostty
After=graphical-session.target
After=dbus.socket
Requires=dbus.socket

[Service]
Type=notify-reload
ReloadSignal=SIGUSR2
BusName=com.mitchellh.ghostty
ExecStart=bwrap --bind / / --dev-bind /dev /dev --bind {{ .Target }}/lib/ghostty/ /usr/lib/x86_64-linux-gnu/ -- {{ .Target }}/ghostty --gtk-single-instance=true --initial-window=false

[Install]
WantedBy=graphical-session.target