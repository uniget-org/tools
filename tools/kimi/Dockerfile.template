#syntax=docker/dockerfile

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
case "${arch}" in
    x86_64) target="x64" ;;
    aarch64) target="arm64" ;;
esac
tag="@moonshot-ai%2Fkimi-code%40${version}"
url="https://github.com/MoonshotAI/kimi-code/releases/download/${tag}/kimi-code-linux-${target}.zip"
filename="$( basename "${url}" )"

check-github-release-asset "MoonshotAI/kimi-code" "@moonshot-ai/kimi-code@${version}" "kimi-code-linux-${target}.zip"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

unzip -o "${uniget_cache_download}/${filename}" -d "${prefix}/bin"
chmod +x "${prefix}/bin/kimi"
EOF
