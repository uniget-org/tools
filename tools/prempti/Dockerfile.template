#syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e

FROM registry.gitlab.com/uniget-org/images/ubuntu:26.04@sha256:0e9f873df6c03f698322571475f367a694d7eff9077e5019ae764e5106a6da16 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
ARG name
ARG version
RUN --mount=type=cache,target=/var/cache/uniget/download <<EOF
echo "### Setting architecture string for ${TARGETPLATFORM}"
case "${arch}" in
    x86_64)
        export arch_suffix="x86_64"
        ;;
    aarch64)
        export arch_suffix="aarch64"
        ;;
    *)
        echo "ERROR: Unsupported architecture ${arch}."
        exit 1
        ;;
esac
echo "    Using ${arch_suffix}"

url="https://github.com/falcosecurity/prempti/releases/download/v${version}/prempti-${version}-linux-${arch_suffix}.tar.gz"
filename="$( basename "${url}" )"

check-github-release-asset "falcosecurity/prempti" "v${version}" "${filename}"
curl --silent --show-error --location --fail --output "${uniget_cache_download}/${filename}" \
    "${url}"

tar --file="${uniget_cache_download}/${filename}" --list
tar --file="${uniget_cache_download}/${filename}" --extract --gzip --directory="${prefix}" --strip-components=1 --no-same-owner

mkdir -p "${prefix}/share/prempti/config/"
find "${prefix}/config" -type f -exec mv {} "${prefix}/share/prempti/config/" \;
mv "${prefix}/rules/" "${prefix}/share/prempti/rules/"

mv "${prefix}/share/libcoding_agent.so" "${prefix}/lib/"

mkdir -p "${prefix}/etc/systemd/user/"
mv "${prefix}/systemd/prempti.service" "${prefix}/etc/systemd/user/prempti.service.go-template"
sed -i "s/@PREFIX@/{{ .Target }}/g" "${prefix}/etc/systemd/user/prempti.service.go-template"

rm \
    "${prefix}/install.sh" \
    "${prefix}/bin/falco"
rmdir \
    "${prefix}/systemd" \
    "${prefix}/config"
EOF
