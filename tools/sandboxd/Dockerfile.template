#syntax=docker/dockerfile

FROM ghcr.io/uniget-org/tools/go:latest AS go

FROM registry.gitlab.com/uniget-org/images/build-essential:26.04 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
COPY --link --from=go / /usr/local/
ARG name
ARG version
WORKDIR /go/src/github.com/tastyeffectco/sandboxd
RUN --mount=type=cache,target=/root/go/pkg/mod <<EOF
check-clone "https://github.com/tastyeffectco/sandboxd" "v${version}"
git clone -q --config advice.detachedHead=false --depth 1 --branch "v${version}" https://github.com/tastyeffectco/sandboxd .
EOF
RUN --mount=type=cache,target=/root/go/pkg/mod <<EOF
echo "### Building control plane"
cd control-plane
CGO_ENABLED=1 go build -trimpath \
    -ldflags "-X main.buildVersion=${version} -X main.buildCommit=$( git rev-parse --short HEAD )" \
    -o "${prefix}/bin/sandboxd" ./cmd/sandboxd
EOF
RUN <<EOF
echo "### Installing migrations"
mkdir -p "${prefix}/share/sandboxd/migrations"
cp --archive control-plane/migrations/. "${prefix}/share/sandboxd/migrations/"
EOF
