#syntax=docker/dockerfile

FROM rust:alpine AS build
RUN <<EOF
apk update
apk add \
    build-base \
    git \
    bash
EOF
WORKDIR /tmp/github.com/01mf02/jaq
ARG version
RUN <<EOF
git clone -q --config advice.detachedHead=false --depth 1 --branch "v${version}" https://github.com/01mf02/jaq .
cargo build --release --target "$(uname -m)-unknown-linux-musl"
cp "target/$(uname -m)-unknown-linux-musl/release/jaq" "/usr/local/bin/"
EOF

FROM registry.gitlab.com/uniget-org/images/alpine:3.24 AS prepare
COPY --from=ghcr.io/uniget-org/tools/uniget-build:latest \
    /etc/profile.d/ \
    /etc/profile.d/
SHELL [ "bash", "-clo", "errexit" ]
COPY --from=build "/usr/local/bin/jaq" "/uniget_bootstrap/bin/"
RUN <<EOF
ln --symbolic --relative --force "/usr/local/bin/jaq" "/usr/local/bin/jq"
EOF